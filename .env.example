PORT=3000
HOST=0.0.0.0

# Troque antes de publicar online.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-antes-de-publicar

# Tempo de validade da sessao. Exemplos: 8h, 1d, 7d.
SESSION_TTL=8h

# Use o dominio real em producao, por exemplo:
# ALLOWED_ORIGIN=https://advocob.onrender.com
ALLOWED_ORIGIN=http://localhost:3000

# Timezone usado para definir "fila do dia".
BUSINESS_TIME_ZONE=America/Fortaleza

# Opcional: protege /painel.html quando publicado online.
# Se definir, acesse a TV com: /painel.html?token=valor-do-token
# PANEL_TOKEN=troque-este-token-do-painel

# Codigo secreto para recuperar a senha do admin sem estar logado.
# Defina no Render e guarde fora do sistema.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_RECOVERY_CODE=troque-este-codigo-de-recuperacao

# Opcional: usernames admin marcados como principais na sessao.
# Acoes criticas exigem role=admin.
SUPERADMIN_USERNAMES=admin

# Backup automatico em arquivo local.
# Em Render/hospedagem gratuita, prefira baixar backups manualmente ou usar storage persistente.
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_RETAIN=14
# BACKUP_DIR=./data/backups

# Supabase/PostgreSQL relacional.
# No Render, use a connection string do Supabase em modo Session Pooler.
# DATABASE_URL=postgresql://postgres.projeto:senha@aws-0-regiao.pooler.supabase.com:5432/postgres

# Storage privado usado para anexar arquivos das guias e dos comprovantes.
# Use uma chave secreta somente no backend do Render; nunca exponha no navegador.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Projetos antigos tambem podem usar SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_GUIDES_BUCKET=advocob-guides
GUIDE_FILE_MAX_MB=10

# Opcional: caminho customizado do banco JSON local.
# Em hospedagem gratuita, nao confie em arquivo local para dados permanentes.
# DATA_DIR=./data
# DB_FILE=./data/database.json
