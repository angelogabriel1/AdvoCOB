PORT=3000

# Troque antes de publicar online.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-antes-de-publicar

# Tempo de validade da sessao. Exemplos: 8h, 1d, 7d.
SESSION_TTL=8h

# Use o dominio real em producao, por exemplo:
# ALLOWED_ORIGIN=https://seu-sistema.onrender.com
ALLOWED_ORIGIN=http://localhost:3000

# Timezone usado para definir "fila do dia".
BUSINESS_TIME_ZONE=America/Fortaleza

# Opcional: protege /painel.html quando publicado online.
# Se definir, acesse a TV com: /painel.html?token=valor-do-token
# PANEL_TOKEN=troque-este-token-do-painel

# Supabase/PostgreSQL.
# No Render, use a connection string do Supabase em modo Session Pooler.
# DATABASE_URL=postgresql://postgres.projeto:senha@aws-0-regiao.pooler.supabase.com:5432/postgres

# Opcional: caminho customizado do banco JSON local.
# Em hospedagem gratuita, nao confie em arquivo local para dados permanentes.
# DATA_DIR=./data
# DB_FILE=./data/database.json
